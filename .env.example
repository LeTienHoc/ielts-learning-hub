# IELTS Learning Hub — environment variables.
# Copy to .env.local and fill in values. Never commit real credentials.
# Local development: run `pnpm db:start`, then `pnpm env:local` to create .env.local
# from the local Supabase stack. Validation: src/config/env/schema.ts

# --- Public (exposed to the browser; never put secrets here) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required. Supabase project URL and publishable key (sb_publishable_…; protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (optional until the feature that needs them) ---
# Supabase secret key (sb_secret_…) — bypasses RLS; only for admin tasks in src/server/**.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_API_KEY=
