# IELTS Learning Hub — environment variables.
# Copy to .env.local and fill in values. Never commit real credentials.
# Every integration variable is optional until that integration is implemented.
# Validation: src/config/env/schema.ts

# --- Public (exposed to the browser; never put secrets here) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets ---
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_API_KEY=
